# 将此文件复制为 .env.stagehand。复制后的文件不得提交。
VHR_BASE_URL=http://127.0.0.1:5173
VHR_STAGEHAND_MODEL=deepseek/deepseek-flash
VHR_STAGEHAND_HEADLESS=false
DEEPSEEK_API_KEY=

# 本地 vhr 数据库中的一次性测试账号，禁止使用生产账号。
VHR_STAGEHAND_USERNAME=
VHR_STAGEHAND_PASSWORD=

# 后续会修改数据的流程，只有显式设为 true 时才允许运行。
VHR_STAGEHAND_ALLOW_WRITE=false
